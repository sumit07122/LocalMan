{
  "name": "localman-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready local services marketplace monorepo for India",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=@localman/constants --workspace=@localman/contracts --workspace=@localman/design-tokens",
    "postinstall": "npm run build:packages && npm run db:generate --workspace=@localman/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:all": "tsx scripts/dev-all.ts",
    "dev:api": "npm run dev --workspace=@localman/api",
    "dev:admin": "npm run dev --workspace=@localman/admin-web",
    "db:start": "tsx scripts/start-local-db.ts",
    "db:migrate": "npm run db:migrate --workspace=@localman/api",
    "db:seed": "npm run db:seed --workspace=@localman/api"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
