# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Secrets
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://localman-admin-web.vercel.app
JWT_SECRET=super_secret_localman_jwt_signing_key_replace_in_prod_2026_xyz
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Database Connection (PostgreSQL)
# For local Docker: postgresql://localman_user:localman_secure_dev_password_2026@localhost:5432/localman_db?schema=public
DATABASE_URL=postgresql://localman_user:localman_secure_dev_password_2026@localhost:5432/localman_db?schema=public

# Redis Configuration (Cache, Sessions, Rate Limits, Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS Gateway Configuration
# Options: 'mock', 'fast2sms', 'msg91', 'twilio'
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_API_KEY=mock_key
SMS_SENDER_ID=LCLMAN
# Twilio specific (when SMS_GATEWAY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 specific (when SMS_GATEWAY_PROVIDER=msg91)
MSG91_TEMPLATE_ID=

# Push Notifications (Firebase Cloud Messaging)
# Options: 'mock', 'fcm'
NOTIFICATION_PROVIDER=mock
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# Payment Gateway Configuration
# Options: 'mock', 'razorpay', 'cashfree'
PAYMENT_GATEWAY_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=rzp_secret_example
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_example

# Cloud Object Storage (S3 / Cloudflare R2)
STORAGE_PROVIDER=mock
S3_BUCKET_NAME=localman-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=mock_gmaps_key
