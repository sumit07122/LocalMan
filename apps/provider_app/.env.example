# ==============================================================================
# LocalMan Partner / Provider Mobile Application Environment Configuration
# ==============================================================================
# Used via Flutter compile-time configuration:
# flutter run --dart-define-from-file=.env
# or: flutter run --dart-define=API_BASE_URL=...
# ==============================================================================

# Environment mode: 'development' | 'staging' | 'production'
ENV=development

# ------------------------------------------------------------------------------
# API Base URL Resolution:
# - Android Emulator: http://10.0.2.2:4000/api/v1 (Auto-resolved default)
# - iOS Simulator / Desktop: http://localhost:4000/api/v1 (Auto-resolved default)
# - Physical Device over LAN: http://<YOUR_MACHINE_LAN_IP>:4000/api/v1
# - Production (mandatory HTTPS): https://api.localman.in/api/v1
# ------------------------------------------------------------------------------
API_BASE_URL=http://10.0.2.2:4000/api/v1

# GPS Location Beacon Dispatch Interval (in seconds, default: 10s)
GPS_BEACON_INTERVAL_SECONDS=10

# Optional Sentry / Error Monitoring DSN
SENTRY_DSN=
