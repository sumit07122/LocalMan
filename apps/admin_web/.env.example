# ==============================================================================
# LocalMan Admin Web Dashboard Environment Configuration
# ==============================================================================

# Backend API Base URL
# - Development: http://localhost:4000 (Vite dev server proxies /api to this port)
# - Production: https://api.localman.in
VITE_API_BASE_URL=http://localhost:4000

# Application Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Web Dashboard Port (default: 3000)
PORT=3000

# Optional Sentry / Error Monitoring DSN
VITE_SENTRY_DSN=
