{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin_web": {
      "root": "apps/admin_web",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin_web"
      }
    }
  ]
}
